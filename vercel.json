{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build:vercel",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "env": {
    "OPENNADEULI_SEARCHOPENTOURISTSPOTS": "",
    "OPENNADEULI_SEARCHACCESSIBLETRAILS": "",
    "OPENNADEULI_SEARCHSTEPFREERESTAURANTS": "",
    "OPENNADEULI_MAPKAKAO": "",
    "OPENNADEULI_USE_LIVE": "false",
    "PORT": "8899",
    "CORS_ORIGINS": ""
  },
  "functions": {
    "api.py": {
      "runtime": "python3.11@1.0.0"
    }
  }
}