{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build:vercel",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "env": {
    "OPENNADEULI_SEARCHOPENTOURISTSPOTS": "",
    "OPENNADEULI_SEARCHACCESSIBLETRAILS": "",
    "OPENNADEULI_SEARCHSTEPFREERESTAURANTS": "",
    "OPENNADEULI_MAPKAKAO": "",
    "OPENNADEULI_USE_LIVE": "false",
    "PORT": "8899",
    "CORS_ORIGINS": "",
    "ENABLE_SETTINGS": "false"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/elice-final.html"
    }
  ]
}
