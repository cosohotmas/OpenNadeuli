# 한국관광공사_국문관광정보 서비스
KorS_End Point=https://apis.data.go.kr/B551011/KorService2
KorS_Key=YOUR_TOURAPI_KEY_HERE

# [개발계정]한국관광공사_무장애 여행 정보
KorWithS_End_Point=https://apis.data.go.kr/B551011/KorWithService2
KorWithS_Key=YOUR_KORWITH_KEY_HERE

# 소상공인시장진흥공단_상가(상권)정보_OpenApi
SdsC_End_Point=https://apis.data.go.kr/B553077/api/open/sdsc2
SdsC_Key=YOUR_SDSC_KEY_HERE

# [개발계정]국립공원공단_탐방로
odcloud_Swagger_URL=https://infuser.odcloud.kr/oas/docs?namespace=15136193/v1
odcloud_Key=YOUR_ODCLOUD_KEY_HERE

# 백엔드 서버 포트 (기본 8899)
PORT=
# CORS 허용 오리진 (쉼표 구분). 비우면 로컬 개발 주소(localhost:5176, 5173)만 허용
CORS_ORIGINS=

