# 서버 전용 공공데이터 키. 실제 값은 로컬 .env 또는 Vercel 환경변수에만 등록.
OPENNADEULI_SEARCHOPENTOURISTSPOTS=
OPENNADEULI_SEARCHSTEPFREERESTAURANTS=
# 비어 있으면 무장애 여행 정보 키 사용
OPENNADEULI_SEARCHSTAYHOTELS=
OPENNADEULI_USE_LIVE=true
ENABLE_SETTINGS=false

# 카카오 지도 JavaScript SDK 공개 키. 도메인 제한 필수.
OPENNADEULI_MAPKAKAO=

# 공개 API 주소. 같은 오리진일 때 비우면 /api 사용.
VITE_API_BASE=
PORT=8899
CORS_ORIGINS=
